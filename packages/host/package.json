{
  "name": "@codex-pocket/host",
  "version": "0.1.2",
  "private": true,
  "description": "Mac-side daemon: connects to the Codex desktop app-server and serves the PWA over the LAN.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codex-pocket": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@codex-pocket/protocol": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
