{
  "name": "codex-pocket",
  "type": "module",
  "private": true,
  "version": "0.3.0",
  "description": "Phone-sized PWA that connects to the official Codex daemon on macOS or Linux over Tailscale or the LAN.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pocket-works/codex-pocket.git"
  },
  "keywords": [
    "codex",
    "openai",
    "pwa",
    "remote",
    "tailscale"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "release:check": "node scripts/check-release.ts",
    "dev:host": "pnpm --filter @codex-pocket/host dev",
    "package:linux": "pnpm --filter @codex-pocket/web build && node scripts/package-linux.ts",
    "package:linux:check": "pnpm --filter @codex-pocket/host exec tsx ../../scripts/check-linux-package.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "esbuild": "^0.28.2"
  }
}
