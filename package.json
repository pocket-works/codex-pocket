{
  "name": "codex-pocket",
  "type": "module",
  "private": true,
  "version": "0.2.1",
  "description": "Phone-sized PWA that connects straight to the Codex desktop app-server on your Mac, over Tailscale or the LAN.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pocket-works/codex-pocket.git"
  },
  "keywords": [
    "codex",
    "openai",
    "pwa",
    "remote",
    "tailscale"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "release:check": "node scripts/check-release.ts",
    "dev:host": "pnpm --filter @codex-pocket/host dev"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
